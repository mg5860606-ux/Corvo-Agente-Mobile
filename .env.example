PRIMARY_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite

# ------- PROVEDOR SECUNDÁRIO / ISA CLOUD / OMNIROUTE (OPCIONAL) -------
OPENAI_BASE_URL=
OPENAI_API_KEY=
