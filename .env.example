# ============================================================
# 🦅 CORVO AGENTE MOBILE - VARIÁVEIS DE AMBIENTE
# ============================================================
# Copie este arquivo para ".env" e preencha com seus valores reais.
# cp .env.example .env
# ============================================================

# ------- PROVEDOR IA PRINCIPAL (ISA CLOUD / OMNIROUTE) -------
OPENAI_BASE_URL=http://127.0.0.1:20129/v1
OPENAI_API_KEY=sk-aaaafd3c5b149509-76c532-c74703a0
ISACLOUD_BASE_URL=http://127.0.0.1:20129/v1
ISACLOUD_API_KEY=sk-aaaafd3c5b149509-76c532-c74703a0
PRIMARY_MODEL=isacloud/gemini-3.8-flash-high

# ------- GOOGLE GEMINI (FALLBACK) -------
# Chave da API do Google Gemini (obtenha em: https://aistudio.google.com/)
GEMINI_API_KEY=

# ------- GATEWAY HTTP -------
# Porta do servidor local do painel web e API
PORT=3333

# Token Bearer de segurança para proteger os endpoints do Gateway.
# Gere um token aleatório seguro e configure aqui.
# Sem este token, qualquer pessoa na rede local pode controlar seu dispositivo!
GATEWAY_AUTH_TOKEN=

# ------- TELEGRAM (OPCIONAL) -------
# Token do Bot obtido via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=

# ------- WHATSAPP (OPCIONAL) -------
# A sessão do WhatsApp é autenticada via QR Code / Pairing Code no primeiro uso.
# Não necessita de variável de ambiente adicional.

# ------- VOZ / TTS (OPCIONAL) -------
# Chave da API ElevenLabs para voz ultra-realista (https://elevenlabs.io/)
ELEVENLABS_API_KEY=
# ID da voz ElevenLabs (padrão: Sarah / EXAVITQu4vr4xnSDxMaL)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ------- IA LOCAL (OPCIONAL) -------
# URL do servidor llama.cpp local (se usar modelo local)
LLAMA_SERVER_URL=http://127.0.0.1:19432/v1
# Caminho do modelo local GGUF
MODEL_PATH=
